# Private URL of the unified admin/Nitro API deployment (server-only, not exposed to browser).
# Example: https://admin.sudutharamain.id
NUXT_API_BASE_URL=https://admin.example.com
NUXT_ANALYTICS_INGEST_SECRET=replace-with-the-same-strong-random-secret-as-admin

# Public origin used by canonical/hreflang/OG links (no trailing slash).
NUXT_PUBLIC_SITE_URL=https://sudutharamain.id

# Temporary visibility toggle for English / bilingual mode.
# false = Indonesian-only public (default safe), true = bilingual ID+EN.
NUXT_PUBLIC_ENGLISH_ENABLED=false
